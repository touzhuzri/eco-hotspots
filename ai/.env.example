# 世界树 AI 服务配置
# 复制为 ai/.env 后填写；.env 已被 .gitignore 忽略。

# 服务商：glm / deepseek / mimo / custom（OpenAI 兼容接口）
AI_PROVIDER=glm

# GLM（智谱）
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.6

# DeepSeek 示例：
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# MiMo 示例（按官方地址填写）：
# AI_PROVIDER=mimo
# AI_BASE_URL=https://api.xiaomimimo.com/v1
# AI_MODEL=mimo-v2-flash

# 在这里填 API Key（不要提交到 git）
AI_API_KEY=

# 内部 AI 服务端口（站点服务器会把 /api/ai 代理到这里）
AI_PORT=8790

# 单次最大输出 token
AI_MAX_TOKENS=2048

# 工具调用轮次上限（演示期放宽；正式部署可调回 4）
AI_MAX_TOOL_ROUNDS=16

# 视觉模型（多模态识图）
# 不填则复用上面的对话服务商；纯文本模型（如 deepseek-chat）无法识图。
# GLM-4V 示例：
# AI_VISION_MODEL=glm-4v-plus
# AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_VISION_API_KEY=视觉服务 Key；留空则用上面的 AI_API_KEY
# 本地 Ollama 示例（需先 ollama pull qwen2.5vl）：
# AI_VISION_BASE_URL=http://127.0.0.1:11434/v1
# AI_VISION_MODEL=qwen2.5vl
# AI_VISION_API_KEY=ollama

# 知识库（RAG）
# 向量模型：GLM 默认 embedding-3；DeepSeek / MiMo 若没有 /embeddings 接口可留空（自动退化为关键词检索）
# AI_EMBED_MODEL=embedding-3
# 单文档最多切多少段、每段字数、重叠字数
# AI_KB_MAX_CHUNKS=240
# AI_KB_CHUNK_SIZE=500
# AI_KB_CHUNK_OVERLAP=80
# 神经向量不可用时的本地特征哈希维度
# AI_KB_LOCAL_DIM=768
