# 世界树 AI 服务配置
# 复制为 ai/.env 后填写；.env 已被 .gitignore 忽略。

# 服务商：glm / deepseek / mimo / custom（OpenAI 兼容接口）
AI_PROVIDER=glm

# GLM（智谱）
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.6

# DeepSeek 示例：
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# MiMo 示例（按官方地址填写）：
# AI_PROVIDER=mimo
# AI_BASE_URL=https://api.xiaomimimo.com/v1
# AI_MODEL=mimo-v2-flash

# 在这里填 API Key（不要提交到 git）
AI_API_KEY=

# 内部 AI 服务端口（站点服务器会把 /api/ai 代理到这里）
AI_PORT=8790

# 单次最大输出 token
AI_MAX_TOKENS=2048

# 工具调用轮次上限（演示期放宽；正式部署可调回 4）
AI_MAX_TOOL_ROUNDS=16
