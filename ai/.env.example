# 世界树 AI 服务配置
# 复制为 ai/.env 后填写；.env 已被 .gitignore 忽略。

# 服务商：deepseek / dspro / dsflash / glm / mimo / custom（OpenAI 兼容接口）
# 默认：DS Pro（DeepSeek 兼容接口）
AI_PROVIDER=dspro

# DS / DS Pro / DS Flash 共用同一个 Base URL
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-pro

# 其它 DS 档位：
# DS：      AI_PROVIDER=deepseek  AI_MODEL=deepseek-chat
# DS Flash：AI_PROVIDER=dsflash   AI_MODEL=deepseek-flash

# GLM（智谱）示例：
# AI_PROVIDER=glm
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4.6

# MiMo 示例（按官方地址填写）：
# AI_PROVIDER=mimo
# AI_BASE_URL=https://api.xiaomimimo.com/v1
# AI_MODEL=mimo-v2-flash

# 在这里填 API Key（不要提交到 git）
AI_API_KEY=

# 内部 AI 服务端口（站点服务器会把 /api/ai 代理到这里）
AI_PORT=8790

# 单次最大输出 token
AI_MAX_TOKENS=2048

# 工具调用轮次上限（演示期放宽；正式部署可调回 4）
AI_MAX_TOOL_ROUNDS=16

# 视觉模型（多模态识图）
# 默认复用 DS 的 Base URL / Key，模型用 DS Flash。
AI_VISION_MODEL=deepseek-flash
# AI_VISION_BASE_URL=https://api.deepseek.com/v1
# AI_VISION_API_KEY=视觉服务 Key；留空则用上面的 AI_API_KEY
# GLM-4V 示例：
# AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_VISION_MODEL=glm-4v-plus
# 本地 Ollama 示例（需先 ollama pull qwen2.5vl）：
# AI_VISION_BASE_URL=http://127.0.0.1:11434/v1
# AI_VISION_MODEL=qwen2.5vl
# AI_VISION_API_KEY=ollama

# 知识库（RAG）
# 默认：SiliconFlow BAAI/bge-m3（免费档，需实名认证；Pro/ 前缀为付费加速版）
AI_EMBED_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBED_MODEL=BAAI/bge-m3
# 必填：SiliconFlow Key；与上面的对话 Key 不同服务商，不能复用
AI_EMBED_API_KEY=

# 智谱 embedding-3 示例（需单独开通 Embedding 资源包，不能复用对话额度）：
# AI_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_EMBED_MODEL=embedding-3
# AI_EMBED_API_KEY=智谱 Key

# 学术文献检索（可选，不填也能用）
# OpenAlex 免费额度按 IP 共享；有自己的 Key 可减少限流
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.com
# Crossref 建议填一个联系邮箱，便于对方在限流时联系
# CROSSREF_MAILTO=you@example.com

# 注意：Base URL 只填到 /v4 或 /v1，不要带 /chat/completions；
# 模型不能填 GLM-4.5-Flash / deepseek-chat 等对话模型。
# 单文档最多切多少段、每段字数、重叠字数
# AI_KB_MAX_CHUNKS=240
# AI_KB_CHUNK_SIZE=500
# AI_KB_CHUNK_OVERLAP=80
# 神经向量不可用时的本地特征哈希维度
# AI_KB_LOCAL_DIM=768
